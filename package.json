{
  "name": "digitama",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icon.mjs && tauri icon src-tauri/icons/source.png -o src-tauri/icons",
    "hook": "cargo build --release -p digitama-hook",
    "tauri": "tauri",
    "predev": "cargo build --release -p digitama-hook",
    "prebuild": "cargo build --release -p digitama-hook",
    "pack": "node scripts/bundle-sprites.mjs && tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2"
  }
}
